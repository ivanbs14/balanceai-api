PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/balance
JWT_SECRET=troque-este-segredo

# URL base do frontend para redirecionar apos callback OAuth
FRONTEND_URL=http://localhost:3000
# Opcional: lista separada por virgula de origens extras permitidas no CORS
# Exemplo: FRONTEND_URLS=https://app.example.com,https://preview.example.com
FRONTEND_URLS=

# Credenciais OAuth Web no Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve bater exatamente com o callback cadastrado no Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
