// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  name      String
  document String  @unique
  email    String  @unique
  password String
  role String @default("user")
  createdAt DateTime @default(now())

  cards  Card[]
  fixedCosts FixedCost[]
}

model Transation {
  id              String                  @id @default(cuid())
  name            String
  type            TransationType
  amount          Decimal                 @db.Decimal(10, 2)
  category        TransationCategory
  paymentMethod   TransationPaymentMethod
  paymentStatus   TransationPaymentStatus @default(PENDING)
  paidAt          DateTime?
  isFixed         Boolean                 @default(false)
  installments    Int?      
  installmentInfo String?  
  nameCard        String?  
  cardId          String? 
  Date            DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  userId          String

  /// Optional: Only used when `type` is `EXPENSE`. Must be `DEPOSIT` or `INVESTMENT`.
  withdrawal      TransationType?
  @@index([cardId])
}

model Card {
  id              String    @id @default(cuid())
  name            String
  invoiceDate     DateTime
  limitBalance    Decimal   @db.Decimal(10, 2)
  invoicePayment  DateTime

  userId          String
  user            User      @relation(fields: [userId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FixedCost {
  id             String               @id @default(cuid())
  userId         String
  name           String
  defaultAmount  Decimal              @db.Decimal(10, 2)
  recurrence     FixedCostRecurrence   @default(MONTHLY)
  dueDay         Int
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User                 @relation(fields: [userId], references: [id])
  monthlys       FixedCostMonthly[]

  @@index([userId])
}

model FixedCostMonthly {
  id           String                 @id @default(cuid())
  fixedCostId  String
  competence   String
  status       FixedCostMonthlyStatus  @default(PENDING)
  amount       Decimal                @db.Decimal(10, 2)
  paidAt       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  fixedCost    FixedCost              @relation(fields: [fixedCostId], references: [id], onDelete: Cascade)

  @@unique([fixedCostId, competence])
  @@index([fixedCostId])
  @@index([competence])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransationType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransationCategory {
  HOUSING
  TRANSPORTION
  FOOD
  ENTERTAINMENT
  HEALTH
  UTILITY
  SALARY
  EDUCATION
  OTHER
}

enum TransationPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  Bank_Transfer
  BANK_SLIP
  CASH
  PIX
  OTHER
}

enum TransationPaymentStatus {
  PENDING
  PAID
}

enum FixedCostRecurrence {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  YEARLY
}

enum FixedCostMonthlyStatus {
  PENDING
  PAID
}
