generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transation {
  id            String                  @id @default(cuid())
  name          String
  type          TransationType
  amount        Decimal                 @db.Decimal(10, 2)
  category      TransationCategory
  paymentMethod TransationPaymentMethod
  Date          DateTime
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  userId        String
}

enum TransationType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransationCategory {
  HOUSING
  TRANSPORTION
  FOOD
  ENTERTAINMENT
  HEALTH
  UTILITY
  SALARY
  EDUCATION
  OTHER
}

enum TransationPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  Bank_Transfer
  BANK_SLIP
  CASH
  PIX
  OTHER
}
